# Anwendung
APP_ENV=production
APP_DEBUG=0
APP_URL=https://example.tld
APP_LOCALE=de-DE
APP_TIMEZONE=Europe/Berlin

# Datenbank (sqlite als Default; pgsql erst ab den in docs/ARCHITEKTUR.md genannten Schwellwerten)
DB_DRIVER=sqlite
DB_DATABASE=storage/db/reptilienmarkt.sqlite

# Ablage
STORAGE_PUBLIC=public/uploads
STORAGE_PRIVATE=storage/private

# Rechts-Engine (Phase 2)
LEGAL_GEFAHRTIER_ENFORCEMENT=1
LEGAL_REVIEW_MAX_AGE_MONTHS=12

# Identitaet: local | dragonreptiles (Phase 5)
IDENTITY_PROVIDER=local

# Mailversand (Phase 5)
# datei = Ablage unter storage/mail (Voreinstellung, verschickt nichts)
# sendmail = ueber den lokalen MTA
MAIL_TRANSPORT=datei
MAIL_DIRECTORY=storage/mail
MAIL_FROM=noreply@example.tld
MAIL_FROM_NAME=Reptilienmarkt

# Name in der Authenticator-App
APP_NAME=Reptilienmarkt

# Monetarisierung (Phase 6 — vorbereitet, nicht aktiviert)
# Der Schalter steht in config/monetarisierung.php; das Setting
# billing.enabled sticht ihn zur Laufzeit. Die Schluessel bleiben leer,
# solange der Zahlungsanbieter "keiner" ist.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Betrieb (Phase 7)
# Protokolle sind JSON-Zeilen, eine Datei je Tag. LOG_LEVEL filtert beim
# Schreiben: debug | info | warning | error | critical.
LOG_DIRECTORY=storage/logs
LOG_LEVEL=info

# Sicherung: bin/backup.php legt die Kopie per VACUUM INTO an — ein
# Dateikopieren im laufenden Betrieb ergaebe eine unbrauchbare Datei.
# BACKUP_KEEP ist die Zahl der aufbewahrten Sicherungen.
BACKUP_DIRECTORY=storage/backups
BACKUP_KEEP=14

# Aufbewahrungsfristen stehen in config/aufbewahrung.php — sie sind eine
# Rechtsentscheidung und gehoeren nicht in eine Umgebungsvariable.
