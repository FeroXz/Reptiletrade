{# role="status" statt eines stummen Absatzes: Die Meldung erscheint nach einer
   Aktion, und wer nicht auf den Bildschirm sieht, erfaehrt sonst nicht, ob das
   Speichern geklappt hat. "polite" unterbricht dabei nichts. #}
{% if meldungen is defined and meldungen is not empty %}
    <div class="space-y-2" role="status" aria-live="polite">
        {% for typ, text in meldungen %}
            {# Die Farbe allein traegt die Aussage nicht — davor steht ein
               Zeichen, das auch ohne Farbwahrnehmung Erfolg von Fehler
               trennt. #}
            <p class="meldung {{ typ == 'fehler' ? 'meldung-fehler' : 'meldung-erfolg' }}">
                <span class="meldung-zeichen" aria-hidden="true">{{ typ == 'fehler' ? '!' : '✓' }}</span>
                <span>{{ text }}</span>
            </p>
        {% endfor %}
    </div>
{% endif %}
