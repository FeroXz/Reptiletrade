{# Eine Anzeige in der Trefferliste. #}
<article class="karte overflow-hidden transition hover:shadow-md">
    <a href="/anzeige/{{ anzeige.id }}/" class="block">
        <div class="aspect-4/3 w-full overflow-hidden" style="background: var(--flaeche-gedaempft)">
            {% if anzeige.imagePath %}
                <img src="/uploads/{{ anzeige.imagePath }}" alt="{{ anzeige.title }}"
                     loading="lazy" class="h-full w-full object-cover">
            {% else %}
                <div class="flex h-full items-center justify-center text-xs gedaempft">Kein Bild</div>
            {% endif %}
        </div>

        <div class="space-y-1 p-3">
            <div class="flex items-start justify-between gap-2">
                <h3 class="line-clamp-2 text-sm font-medium">{{ anzeige.title }}</h3>
                {% if anzeige.isFeatured %}
                    <span class="shrink-0 rounded-sm bg-primary-100 px-1.5 py-0.5 text-[11px] font-medium text-primary-800">Top</span>
                {% endif %}
            </div>

            <p class="text-xs gedaempft">{{ anzeige.speciesCommonName }}</p>

            {% if anzeige.morphNames is not empty %}
                <p class="line-clamp-1 text-xs text-primary-700">{{ anzeige.morphLabel }}</p>
            {% endif %}

            <div class="flex items-center gap-2 pt-1 text-xs gedaempft">
                <span>{{ anzeige.sex.symbol }}</span>
                <span>·</span>
                <span>{{ anzeige.cbStatus.label }}</span>
                {% if anzeige.postalCode %}
                    <span>·</span>
                    <span>{{ anzeige.country ? anzeige.country.value ~ '-' : '' }}{{ anzeige.postalCode }}</span>
                {% endif %}
            </div>

            <div class="flex items-baseline justify-between pt-1">
                <span class="text-sm font-semibold">{{ anzeige.formattedPrice }}</span>
                {% if anzeige.formattedDistance %}
                    <span class="text-xs gedaempft">{{ anzeige.formattedDistance }}</span>
                {% endif %}
            </div>
        </div>
    </a>
</article>
