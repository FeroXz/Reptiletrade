{% extends 'layout/basis.html.twig' %}
{% block titel %}Moderation — Reptilienmarkt{% endblock %}
{% block kopf %}<meta name="robots" content="noindex">{% endblock %}

{% block inhalt %}
    <div class="mx-auto max-w-5xl space-y-6">
        {% include 'partials/meldungen.html.twig' with {'meldungen': flash} %}

        <h1 class="text-xl font-semibold">Moderation <span class="gedaempft">({{ offen_gesamt }} offen)</span></h1>

        {# ------------------------------------------------------------ Meldungen #}
        <section class="space-y-2">
            <h2 class="font-semibold">Meldungen</h2>

            {% if meldungen_offen is empty %}
                <p class="karte p-4 text-sm gedaempft">Nichts offen.</p>
            {% else %}
                <ul class="space-y-2">
                    {% for meldung in meldungen_offen %}
                        <li class="karte space-y-2 p-4">
                            <div class="flex flex-wrap items-baseline justify-between gap-2 text-sm">
                                <span>
                                    <strong>{{ meldung.reason.label }}</strong>
                                    — {{ meldung.targetType.label }} #{{ meldung.targetId }}
                                </span>
                                <span class="gedaempft">
                                    {{ meldung.status.label }}
                                    {% if meldung.createdAt %}, {{ meldung.createdAt.format('d.m.Y H:i') }}{% endif %}
                                </span>
                            </div>

                            {% if meldung.description %}
                                <p class="whitespace-pre-line text-sm">{{ meldung.description }}</p>
                            {% endif %}

                            <form method="post" action="/moderation/meldung/{{ meldung.id }}" class="flex flex-wrap gap-2">
                                <input type="hidden" name="_csrf" value="{{ csrf }}">
                                <input class="feld w-auto flex-1" type="text" name="notiz" placeholder="Notiz (optional)">
                                <select class="feld w-auto" name="status" aria-label="Entscheidung">
                                    <option value="in_pruefung">In Prüfung</option>
                                    <option value="erledigt">Erledigt</option>
                                    <option value="abgelehnt">Abgelehnt</option>
                                </select>
                                <button type="submit" class="knopf">Speichern</button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        {# --------------------------------------------------- Anzeigen in Prüfung #}
        <section class="space-y-2">
            <h2 class="font-semibold">Anzeigen in Prüfung</h2>

            {% if anzeigen_in_pruefung is empty %}
                <p class="karte p-4 text-sm gedaempft">Nichts offen.</p>
            {% else %}
                <ul class="space-y-2">
                    {% for anzeige in anzeigen_in_pruefung %}
                        <li class="karte space-y-2 p-4">
                            <a class="font-medium underline" href="/anzeige/{{ anzeige.id }}/">{{ anzeige.title }}</a>

                            <form method="post" action="/moderation/anzeige/{{ anzeige.id }}" class="flex flex-wrap gap-2">
                                <input type="hidden" name="_csrf" value="{{ csrf }}">
                                <input class="feld w-auto flex-1" type="text" name="notiz" placeholder="Notiz (optional)">
                                <button type="submit" name="entscheidung" value="freigeben" class="knopf knopf-primaer">
                                    Freigeben
                                </button>
                                <button type="submit" name="entscheidung" value="sperren" class="knopf">Sperren</button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        {# ------------------------------------------------- Markierte Nachrichten #}
        <section class="space-y-2">
            <h2 class="font-semibold">Markierte Nachrichten</h2>

            {% if markierte_nachrichten is empty %}
                <p class="karte p-4 text-sm gedaempft">Nichts markiert.</p>
            {% else %}
                <ul class="space-y-2">
                    {% for nachricht in markierte_nachrichten %}
                        <li class="karte p-4 text-sm">
                            <p class="gedaempft">
                                Gespräch #{{ nachricht.conversationId }}, Absender #{{ nachricht.senderId }}
                                {% if nachricht.createdAt %}, {{ nachricht.createdAt.format('d.m.Y H:i') }}{% endif %}
                            </p>
                            <p class="mt-1"><strong>Treffer:</strong> {{ nachricht.flaggedReason }}</p>
                            {# Der ungefilterte Wortlaut — die Moderation braucht das Original. #}
                            <p class="mt-1 whitespace-pre-line">{{ nachricht.body }}</p>
                            <p class="mt-1">
                                <a class="underline" href="/melden/message/{{ nachricht.id }}">Als Meldung anlegen</a>
                            </p>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        {# ------------------------------------------------------------ Nachweise #}
        <section class="space-y-2">
            <h2 class="font-semibold">Identitätsnachweise</h2>

            {% if nachweise is empty %}
                <p class="karte p-4 text-sm gedaempft">Nichts offen.</p>
            {% else %}
                <ul class="space-y-2">
                    {% for nachweis in nachweise %}
                        <li class="karte space-y-2 p-4 text-sm">
                            <p>
                                <strong>{{ nachweis.docType.label }}</strong> von Konto #{{ nachweis.userId }}
                                — {{ nachweis.originalFilename }}
                                {% if nachweis.createdAt %}
                                    <span class="gedaempft">({{ nachweis.createdAt.format('d.m.Y') }})</span>
                                {% endif %}
                            </p>

                            <form method="post" action="/moderation/nachweis/{{ nachweis.id }}" class="flex flex-wrap gap-2">
                                <input type="hidden" name="_csrf" value="{{ csrf }}">
                                <input class="feld w-auto flex-1" type="text" name="notiz" placeholder="Notiz (optional)">
                                <button type="submit" name="entscheidung" value="annehmen" class="knopf knopf-primaer">
                                    Annehmen
                                </button>
                                <button type="submit" name="entscheidung" value="ablehnen" class="knopf">Ablehnen</button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </div>
{% endblock %}
