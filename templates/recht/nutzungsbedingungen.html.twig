{% extends 'layout/basis.html.twig' %}
{% block titel %}Nutzungsbedingungen — Reptilienmarkt{% endblock %}

{% block inhalt %}
    <div class="mx-auto max-w-2xl space-y-6">
        <h1 class="text-xl font-semibold">Nutzungsbedingungen</h1>

        {% include 'recht/unvollstaendig.html.twig' %}

        <div class="karte border-amber-300 p-4 text-sm">
            <p class="font-semibold">Entwurf — vor dem Start anwaltlich prüfen lassen.</p>
            <p class="mt-1">
                Die folgenden Regeln beschreiben, wie die Plattform tatsächlich arbeitet. Sie ersetzen keine
                geprüften AGB. Wer gewerblich verkauft, braucht darüber hinaus eigene Bedingungen,
                Widerrufsbelehrung und Preisangaben nach PAngV — dafür ist der jeweilige Anbieter zuständig,
                nicht die Plattform.
            </p>
        </div>

        {% include 'recht/_abschnitte.html.twig' %}

        <section class="karte space-y-2 p-6">
            <h2 class="font-semibold">{{ disclaimer_titel }}</h2>
            <p class="text-sm">{{ disclaimer_text }}</p>
        </section>

        <p class="text-sm gedaempft">
            Siehe auch <a class="underline" href="/impressum">Impressum</a> und
            <a class="underline" href="/datenschutz">Datenschutzerklärung</a>.
        </p>
    </div>
{% endblock %}
