{% extends 'layout/basis.html.twig' %}
{% block titel %}Datenschutzerklärung — Reptilienmarkt{% endblock %}

{% block inhalt %}
    <div class="mx-auto max-w-2xl space-y-6">
        <h1 class="text-xl font-semibold">Datenschutzerklärung</h1>

        {% include 'recht/unvollstaendig.html.twig' %}

        <section class="karte space-y-2 p-6">
            <h2 class="font-semibold">Verantwortlicher</h2>
            <address class="not-italic text-sm">
                {% for zeile in anschrift %}<div>{{ zeile }}</div>{% endfor %}
                <div>E-Mail: <a class="underline" href="mailto:{{ kontakt.email }}">{{ kontakt.email }}</a></div>
            </address>
            {% if datenschutz.beauftragter %}
                <p class="text-sm">
                    Datenschutzbeauftragte Person: {{ datenschutz.beauftragter }}
                    {% if datenschutz.beauftragter_email %} ({{ datenschutz.beauftragter_email }}){% endif %}
                </p>
            {% endif %}
        </section>

        {% include 'recht/_abschnitte.html.twig' %}

        <p class="text-sm gedaempft">
            Siehe auch <a class="underline" href="/impressum">Impressum</a> und
            <a class="underline" href="/nutzungsbedingungen">Nutzungsbedingungen</a>.
        </p>
    </div>
{% endblock %}
