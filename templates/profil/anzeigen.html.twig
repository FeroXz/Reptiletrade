{% extends 'layout/basis.html.twig' %}
{% block titel %}{{ inhaber.displayName }} — Züchterprofil{% endblock %}
{% block beschreibung %}{{ profil.headline|default('Züchterprofil von ' ~ inhaber.displayName) }}{% endblock %}

{% block inhalt %}
    <div class="mx-auto max-w-5xl space-y-6">
        {% include 'partials/meldungen.html.twig' %}

        <header class="karte space-y-3 p-6">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                    <h1 class="text-xl font-semibold">{{ inhaber.displayName }}</h1>
                    {% if profil.headline %}<p class="gedaempft">{{ profil.headline }}</p>{% endif %}

                    <p class="mt-2 flex flex-wrap gap-2 text-xs">
                        <span class="rounded-full px-2 py-0.5" style="background: var(--rand)">
                            {{ inhaber.verificationLevel.badge }}
                        </span>
                        {% if inhaber.isCommercial %}
                            <span class="rounded-full px-2 py-0.5" style="background: var(--rand)">
                                Gewerblicher Anbieter
                            </span>
                        {% endif %}
                        {% if profil.breedingSince %}
                            <span class="rounded-full px-2 py-0.5" style="background: var(--rand)">
                                {{ tw('profil.zuchtjahre', profil.breedingYears(date())) }}
                            </span>
                        {% endif %}
                        {% if not profil.isPublic %}
                            <span class="rounded-full px-2 py-0.5" style="background: var(--rand)">
                                {{ t('profil.nicht_oeffentlich') }}
                            </span>
                        {% endif %}
                    </p>
                </div>

                <div class="text-right text-sm">
                    {% if bewertungen.hasReviews %}
                        <p class="text-lg font-semibold">{{ bewertungen.rounded|number_format(1, ',', '.') }} / 5</p>
                        <p class="gedaempft">{{ tw('bewertung.anzahl', bewertungen.count) }}</p>
                    {% else %}
                        <p class="gedaempft">{{ t('bewertung.keine') }}</p>
                    {% endif %}

                    <p class="mt-2">
                        {% if ist_inhaber %}
                            <a class="knopf" href="/konto/profil">{{ t('profil.bearbeiten') }}</a>
                        {% elseif betrachter.isAuthenticated %}
                            <a class="text-xs gedaempft underline" href="/melden/user/{{ inhaber.id }}">
                                {{ t('meldung.titel') }}
                            </a>
                        {% endif %}
                    </p>
                </div>
            </div>

            {% if profil.description %}
                <p class="whitespace-pre-line border-t pt-3" style="border-color: var(--rand)">{{ profil.description }}</p>
            {% endif %}

            {% if schwerpunkt is not empty %}
                <p class="text-sm">
                    <strong>{{ t('profil.schwerpunkt') }}:</strong>
                    {% for art in schwerpunkt %}
                        <a class="underline" href="/art/{{ art.slug }}/">{{ art.commonNameDe }}</a>{% if not loop.last %}, {% endif %}
                    {% endfor %}
                </p>
            {% endif %}

            {% if profil.website %}
                <p class="text-sm">
                    <a class="underline" href="{{ profil.website }}" rel="nofollow noopener external" target="_blank">
                        {{ profil.website }}
                    </a>
                </p>
            {% endif %}
        </header>

        {# ------------------------------------------------------------ Anzeigen #}
        <section class="space-y-3">
            <h2 class="font-semibold">Aktive Anzeigen ({{ statistik.aktive_anzeigen }})</h2>

            {% if anzeigen is empty %}
                <p class="karte p-6 text-sm gedaempft">{{ t('profil.keine_anzeigen') }}</p>
            {% else %}
                <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                    {% for anzeige in anzeigen %}
                        <li class="karte p-3">
                            <a class="font-medium underline" href="/anzeige/{{ anzeige.id }}/">{{ anzeige.title }}</a>
                            <p class="mt-1 text-sm gedaempft">{{ anzeige.priceCents|preis(anzeige.currency) }}</p>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        {# --------------------------------------------------------- Bewertungen #}
        <section class="space-y-3">
            <h2 class="font-semibold">{{ t('bewertung.titel') }}</h2>

            {% if letzte_bewertungen is empty %}
                <p class="karte p-6 text-sm gedaempft">{{ t('bewertung.keine') }}</p>
            {% else %}
                <ul class="space-y-2">
                    {% for eintrag in letzte_bewertungen %}
                        <li class="karte p-4">
                            <div class="flex items-baseline justify-between gap-2 text-sm">
                                <span><strong>{{ eintrag.bewertung.rating }} / 5</strong> von {{ eintrag.autor }}</span>
                                {% if eintrag.bewertung.createdAt %}
                                    <time class="gedaempft" datetime="{{ eintrag.bewertung.createdAt.format('c') }}">
                                        {{ eintrag.bewertung.createdAt.format('d.m.Y') }}
                                    </time>
                                {% endif %}
                            </div>
                            {% if eintrag.bewertung.hasComment %}
                                <p class="mt-1 whitespace-pre-line text-sm">{{ eintrag.bewertung.comment }}</p>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </div>
{% endblock %}
