{% extends 'layout/basis.html.twig' %}
{% block titel %}Passwort vergessen — Reptilienmarkt{% endblock %}

{% block inhalt %}
    {# Auth-Flows stehen fuer sich: keine Navigation im Blick, eine Karte
       in der Mitte. Der Grund dahinter ist ein Verlauf aus zwei Tokenfarben
       und liegt fest im Bild — kein Bildasset, kein zusaetzlicher Ladevorgang,
       und beim Scrollen wandert das Licht nicht mit.
       min-h rechnet Kopfleiste und Innenabstand des main heraus, damit die
       Karte optisch mittig sitzt und nicht oben klebt. #}
    <div class="hintergrund-buehne" aria-hidden="true"></div>

    <div class="mx-auto flex min-h-[calc(100dvh-18rem)] max-w-md flex-col justify-center gap-5 py-6">
        {% include 'partials/meldungen.html.twig' %}

        <form method="post" action="/passwort/vergessen" class="karte karte-gross glass space-y-5 p-7 sm:p-9">
            <div class="space-y-2">
                <p class="vorzeile">Zugang wiederherstellen</p>
                <h1 class="text-h2">Passwort vergessen</h1>
            </div>
            <input type="hidden" name="_csrf" value="{{ csrf }}">

            <p class="text-sm gedaempft">
                Gib die Adresse deines Kontos an. Wir schicken dir einen Link, mit dem du ein neues
                Passwort vergibst. Der Link gilt eine Stunde und lässt sich nur einmal verwenden.
            </p>

            <div>
                <label class="feld-marke" for="email">E-Mail</label>
                <input class="feld" id="email" type="email" name="email" required autocomplete="email">
            </div>

            <button type="submit" class="knopf knopf-primaer w-full justify-center">Link anfordern</button>
            <p class="text-sm gedaempft"><a class="underline" href="/anmelden">Zurück zur Anmeldung</a></p>
        </form>
    </div>
{% endblock %}
