{% extends 'layout/basis.html.twig' %}
{% block titel %}Anmelden — Reptilienmarkt{% endblock %}

{% block inhalt %}
    {# Auth-Flows stehen fuer sich: keine Navigation im Blick, eine Karte
       in der Mitte. min-h rechnet Kopfleiste und Innenabstand des main
       heraus, damit die Karte optisch mittig sitzt und nicht oben klebt. #}
    <div class="mx-auto flex min-h-[calc(100dvh-14rem)] max-w-sm flex-col justify-center gap-4 py-4">
        {% include 'partials/meldungen.html.twig' %}

        <form method="post" action="/anmelden" class="karte karte-gross space-y-4 p-6 sm:p-8">
            <h1 class="text-xl font-semibold tracking-tight">Anmelden</h1>
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            {% if weiter %}<input type="hidden" name="weiter" value="{{ weiter }}">{% endif %}

            <div>
                <label class="feld-marke" for="email">E-Mail</label>
                <input class="feld" id="email" type="email" name="email" required autocomplete="email"
                       value="{{ eingaben.email|default('') }}">
            </div>

            <div>
                <label class="feld-marke" for="passwort">Passwort</label>
                <input class="feld" id="passwort" type="password" name="passwort" required autocomplete="current-password">
            </div>

            <button type="submit" class="knopf knopf-primaer w-full justify-center">Anmelden</button>
            <p class="text-sm gedaempft">Noch kein Konto? <a class="underline" href="/registrieren">Registrieren</a></p>
        </form>
    </div>
{% endblock %}
