{% extends 'layout/basis.html.twig' %}

{% block titel %}
    {%- if art -%}
        {{ art.commonNameDe }} kaufen und tauschen
    {%- else -%}
        Terrarientiere kaufen, tauschen und abgeben
    {%- endif -%}
    {{ ' — Reptilienmarkt' }}
{% endblock %}

{% block beschreibung %}
    {%- if art -%}
        {{ ergebnis.total }} Anzeigen für {{ art.commonNameDe }} ({{ art.scientificName }}) im DACH-Raum.
    {%- else -%}
        {{ ergebnis.total }} Anzeigen für Terrarientiere in Deutschland, Österreich und der Schweiz.
    {%- endif -%}
{% endblock %}

{% block inhalt %}
    <div class="grid gap-6 lg:grid-cols-[18rem_1fr]" data-markt>

        {# ------------------------------------------------------------ Facetten #}
        {# Der Umschalter haengt an markt.js statt an Alpine-Ausdruecken im
           Markup: Die werden zur Laufzeit aus Zeichenketten gebaut, und dafuer
           braeuchte die Content-Security-Policy 'unsafe-eval' — womit sie
           gegen eingeschleuste Skripte kaum noch schuetzt. #}
        <aside class="karte h-fit p-4" data-facetten>
            <div class="flex items-center justify-between lg:block">
                <h2 class="text-sm font-semibold">Filter</h2>
                <button type="button" class="knopf lg:hidden" data-facetten-schalter
                        aria-expanded="false" aria-controls="facetten-inhalt">Anzeigen</button>
            </div>

            <div id="facetten-inhalt" class="mt-3 space-y-5 hidden lg:block" data-facetten-inhalt>
                {% if kriterien.isFiltered %}
                    <a href="/markt/" class="knopf w-full justify-center">Alle Filter zurücksetzen</a>

                    {# Suche merken. Das Formular schickt an die eigene Adresse
                       zurück — damit entstehen die Kriterien beim Speichern
                       genauso wie beim Anzeigen. #}
                    <div class="space-y-2">
                        <h3 class="text-xs font-semibold uppercase tracking-wide gedaempft">
                            {{ t('suchen.merken') }}
                        </h3>

                        {% if angemeldet %}
                            <form method="post" action="{{ markt_url(kriterien.withPage(1), url_kontext) }}"
                                  class="space-y-2">
                                <input type="hidden" name="_csrf" value="{{ csrf }}">
                                <label class="sr-only" for="suche-name">{{ t('suchen.name') }}</label>
                                <input class="feld" id="suche-name" type="text" name="name" maxlength="80"
                                       placeholder="{{ t('suchen.name') }}" required>
                                <button type="submit" class="knopf w-full justify-center">
                                    {{ t('suchen.merken_knopf') }}
                                </button>
                            </form>
                        {% else %}
                            <p class="text-xs gedaempft">{{ t('suchen.nur_angemeldet') }}</p>
                            <a class="knopf w-full justify-center"
                               href="/anmelden?weiter={{ markt_url(kriterien.withPage(1), url_kontext)|url_encode }}">
                                {{ t('suchen.anmelden') }}
                            </a>
                        {% endif %}
                    </div>
                {% endif %}

                {# Umkreis #}
                <form action="/markt/" method="get" class="space-y-2">
                    {% if kriterien.query %}<input type="hidden" name="q" value="{{ kriterien.query }}">{% endif %}
                    {% if art %}<input type="hidden" name="art_id" value="{{ art.id }}">{% endif %}
                    <h3 class="text-xs font-semibold uppercase tracking-wide gedaempft">Standort</h3>
                    <input class="feld" type="text" name="plz" inputmode="numeric" placeholder="PLZ"
                           value="{{ kriterien.radius ? kriterien.radius.postalCode : '' }}">
                    <select class="feld" name="umkreis">
                        {% for umkreis in umkreise %}
                            <option value="{{ umkreis.value }}"
                                {{ kriterien.radius and kriterien.radius.radius == umkreis ? 'selected' : '' }}>
                                {{ umkreis.label }}
                            </option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="knopf w-full justify-center">Umkreis anwenden</button>
                    {% if kriterien.radius %}
                        <p class="text-xs gedaempft">Aktuell: {{ kriterien.radius.label }}</p>
                    {% endif %}
                </form>

                {# Art #}
                {% set artzahlen = facetten.forDimension(dimension.art) %}
                {% if artzahlen is not empty %}
                    <section class="space-y-1">
                        <h3 class="text-xs font-semibold uppercase tracking-wide gedaempft">Art</h3>
                        {% for wert, anzahl in artzahlen|slice(0, 12) %}
                            {% set aktiv = kriterien.speciesId == wert %}
                            <a class="flex items-center justify-between rounded px-2 py-1 text-sm {{ aktiv ? 'facette-aktiv' : '' }}"
                               href="{{ markt_url(kriterien.with(speciesId: aktiv ? null : wert, morphs: [], page: 1), url_kontext) }}">
                                <span>{{ facetten.label(wert, 'Art ' ~ wert) }}</span>
                                <span class="text-xs gedaempft">{{ anzahl }}</span>
                            </a>
                        {% endfor %}
                    </section>
                {% endif %}

                {# Morphs mit Zygosität #}
                {% if morph_facette is not empty %}
                    <section class="space-y-1">
                        <h3 class="text-xs font-semibold uppercase tracking-wide gedaempft">Merkmale</h3>
                        {% for eintrag in morph_facette|slice(0, 15) %}
                            <a class="flex items-center justify-between rounded px-2 py-1 text-sm"
                               href="/markt/?{{ art ? 'art_id=' ~ art.id ~ '&' : '' }}morph={{ eintrag.morph_id }}:{{ eintrag.zygosity }}">
                                <span>
                                    {{ eintrag.name }}
                                    {% if eintrag.zygosity != 'visual' %}
                                        <span class="text-xs gedaempft">({{ eintrag.zygosity|replace({'poss_het_66': '66% poss. het', 'poss_het_50': '50% poss. het'}) }})</span>
                                    {% endif %}
                                </span>
                                <span class="text-xs gedaempft">{{ eintrag.anzahl }}</span>
                            </a>
                        {% endfor %}
                    </section>
                {% endif %}

                {# Aufzählungsfacetten #}
                {% for block in [
                    { titel: 'Anzeigenart', dim: dimension.typ, faelle: typen, gewaehlt: kriterien.types, feld: 'types' },
                    { titel: 'Geschlecht', dim: dimension.geschlecht, faelle: geschlechter, gewaehlt: kriterien.sexes, feld: 'sexes' },
                    { titel: 'Herkunft', dim: dimension.herkunft, faelle: herkuenfte, gewaehlt: kriterien.cbStatuses, feld: 'cbStatuses' },
                    { titel: 'Land', dim: dimension.land, faelle: laender, gewaehlt: kriterien.countries, feld: 'countries' },
                    { titel: 'Übergabe', dim: dimension.uebergabe, faelle: uebergaben, gewaehlt: kriterien.handovers, feld: 'handovers' }
                ] %}
                    <section class="space-y-1">
                        <h3 class="text-xs font-semibold uppercase tracking-wide gedaempft">{{ block.titel }}</h3>
                        {% for fall in block.faelle %}
                            {% set anzahl = facetten.count(block.dim, fall.value) %}
                            {% set aktiv = fall in block.gewaehlt %}
                            {% if anzahl > 0 or aktiv %}
                                {% set neu = aktiv
                                    ? block.gewaehlt|filter(v => v != fall)|werte
                                    : block.gewaehlt|merge([fall]) %}
                                <a class="flex items-center justify-between rounded px-2 py-1 text-sm {{ aktiv ? 'facette-aktiv' : '' }}"
                                   href="{{ markt_url(
                                       block.feld == 'types' ? kriterien.with(types: neu, page: 1)
                                       : block.feld == 'sexes' ? kriterien.with(sexes: neu, page: 1)
                                       : block.feld == 'cbStatuses' ? kriterien.with(cbStatuses: neu, page: 1)
                                       : block.feld == 'countries' ? kriterien.with(countries: neu, page: 1)
                                       : kriterien.with(handovers: neu, page: 1), url_kontext) }}">
                                    <span>{{ fall.label }}</span>
                                    <span class="text-xs gedaempft">{{ anzahl }}</span>
                                </a>
                            {% endif %}
                        {% endfor %}
                    </section>
                {% endfor %}

                {# Preis, Alter, Bild #}
                <form action="/markt/" method="get" class="space-y-2">
                    {% if art %}<input type="hidden" name="art_id" value="{{ art.id }}">{% endif %}
                    {% if kriterien.query %}<input type="hidden" name="q" value="{{ kriterien.query }}">{% endif %}
                    <h3 class="text-xs font-semibold uppercase tracking-wide gedaempft">Preis (EUR)</h3>
                    <div class="flex gap-2">
                        <input class="feld" type="number" min="0" name="preis_min" placeholder="von"
                               value="{{ kriterien.priceMinCents ? (kriterien.priceMinCents // 100) : '' }}">
                        <input class="feld" type="number" min="0" name="preis_max" placeholder="bis"
                               value="{{ kriterien.priceMaxCents ? (kriterien.priceMaxCents // 100) : '' }}">
                    </div>

                    <h3 class="pt-2 text-xs font-semibold uppercase tracking-wide gedaempft">Alter (Monate)</h3>
                    <div class="flex gap-2">
                        <input class="feld" type="number" min="0" name="alter_min" placeholder="von"
                               value="{{ kriterien.ageMinMonths ?? '' }}">
                        <input class="feld" type="number" min="0" name="alter_max" placeholder="bis"
                               value="{{ kriterien.ageMaxMonths ?? '' }}">
                    </div>

                    <label class="flex items-center gap-2 pt-2 text-sm">
                        <input type="checkbox" name="mit_bild" value="1" {{ kriterien.withImageOnly ? 'checked' : '' }}>
                        Nur mit Bild
                    </label>

                    <button type="submit" class="knopf knopf-primaer w-full justify-center">Anwenden</button>
                </form>
            </div>
        </aside>

        {# ------------------------------------------------------------ Treffer #}
        <section>
            <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
                <div>
                    <h1 class="text-xl font-semibold">
                        {% if art %}{{ art.commonNameDe }}{% else %}Alle Anzeigen{% endif %}
                    </h1>
                    <p class="text-sm gedaempft">
                        {{ ergebnis.total }} Treffer
                        {%- if kriterien.radius %} im Umkreis von {{ kriterien.radius.label }}{% endif %}
                        <span class="ml-1 text-xs">({{ ergebnis.durationMs|number_format(0) }} ms)</span>
                    </p>
                </div>

                <form action="{{ markt_url(kriterien, url_kontext)|split('?')|first }}" method="get" class="flex items-center gap-2">
                    <label for="sortierung" class="text-sm gedaempft">Sortierung</label>
                    <select id="sortierung" class="feld w-auto" name="sortierung" onchange="this.form.submit()">
                        {% for sortierung in sortierungen %}
                            <option value="{{ sortierung.value }}" {{ kriterien.effectiveSort == sortierung ? 'selected' : '' }}>
                                {{ sortierung.label }}
                            </option>
                        {% endfor %}
                    </select>
                </form>
            </div>

            <div data-treffer>
                {% if ergebnis.isEmpty %}
                    <div class="karte p-8 text-center">
                        <p class="font-medium">Keine Anzeigen gefunden.</p>
                        <p class="mt-1 text-sm gedaempft">Weniger Filter oder ein größerer Umkreis bringen meist mehr Treffer.</p>
                    </div>
                {% else %}
                    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 xl:grid-cols-4">
                        {% for anzeige in ergebnis.listings %}
                            {% include 'partials/kachel.html.twig' with { anzeige: anzeige } only %}
                        {% endfor %}
                    </div>
                {% endif %}

                {% include 'partials/paginierung.html.twig' %}
            </div>
        </section>
    </div>
{% endblock %}

{% block skripte %}
    <script src="/assets/markt.js" defer></script>
{% endblock %}
