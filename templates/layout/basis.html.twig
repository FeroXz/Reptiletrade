<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block titel %}Reptilienmarkt{% endblock %}</title>
    <meta name="description" content="{% block beschreibung %}Verkaufs- und Tauschplattform für Terrarientiere im DACH-Raum.{% endblock %}">
    {% block kopf %}{% endblock %}
    <link rel="stylesheet" href="/assets/app.css">
</head>
<body class="min-h-screen">
<header class="border-b" style="background: var(--flaeche); border-color: var(--rand)">
    <div class="mx-auto flex max-w-7xl items-center gap-6 px-4 py-3">
        <a href="/markt/" class="text-lg font-semibold tracking-tight">Reptilienmarkt</a>
        <form action="/markt/" method="get" class="flex flex-1 items-center gap-2" role="search">
            <label for="suchfeld" class="sr-only">Suchbegriff</label>
            <input id="suchfeld" type="search" name="q" class="feld" placeholder="Art, Morph oder Stichwort"
                   value="{{ kriterien is defined and kriterien.query ? kriterien.query : '' }}">
            <button type="submit" class="knopf knopf-primaer">Suchen</button>
        </form>

        {# Das Hauptmenü wird von der Redaktion gepflegt. Ist es leer, fehlt
           hier schlicht nichts — die Kontonavigation daneben bleibt. #}
        {% if betrachter is defined and betrachter.menu('hauptmenu') is not empty %}
            <nav class="hidden items-center gap-4 text-sm lg:flex" aria-label="{{ t('inhalt.hauptmenu') }}">
                {% for eintrag in betrachter.menu('hauptmenu') %}
                    <a href="{{ eintrag.resolvedPath }}"
                       {% if eintrag.isExternal %}rel="noopener noreferrer"{% endif %}>{{ eintrag.label }}</a>
                {% endfor %}
            </nav>
        {% endif %}

        <nav class="flex items-center gap-4 text-sm" aria-label="Konto">
            {% if betrachter is defined and betrachter.isAuthenticated %}
                <a href="/postfach/" class="flex items-center gap-1">
                    {{ t('postfach.titel') }}
                    {% if betrachter.unreadMessages > 0 %}
                        <span class="rounded-full px-2 py-0.5 text-xs font-semibold"
                              style="background: var(--warnung-flaeche, #fde68a); color: var(--warnung-text, #78350f)"
                              aria-label="{{ tw('postfach.ungelesen', betrachter.unreadMessages) }}">
                            {{ betrachter.unreadMessages }}
                        </span>
                    {% endif %}
                </a>
                <a href="/meine-anzeigen/">Meine Anzeigen</a>
                <a href="/konto/">{{ t('konto.titel') }}</a>
                {% if betrachter.isModerator %}
                    <a href="/moderation/">Moderation</a>
                {% endif %}
                {% if betrachter.isEditor %}
                    <a href="/admin/inhalte">{{ t('admin.inhalt.titel') }}</a>
                {% endif %}
                {% if betrachter.isAdmin %}
                    <a href="/admin/">{{ t('admin.titel') }}</a>
                {% endif %}
            {% else %}
                <a href="/anmelden">Anmelden</a>
                <a href="/registrieren" class="knopf">Registrieren</a>
            {% endif %}
        </nav>
    </div>
</header>

<main class="mx-auto max-w-7xl px-4 py-6">
    {% block inhalt %}{% endblock %}
</main>

<footer class="mx-auto max-w-7xl space-y-3 px-4 py-10 text-sm gedaempft">
    <p>
        Angaben zu Schutzstatus und Nachweispflichten sind Hinweise, keine Rechtsberatung.
        Prüfe vor Kauf und Abgabe die für dich geltenden Vorschriften.
    </p>
    {# Impressum und Datenschutz gehoeren auf jede Seite und muessen mit
       hoechstens zwei Klicks erreichbar sein. #}
    {# Impressum und Datenschutz stehen fest verdrahtet hier — sie muessen mit
       hoechstens zwei Klicks erreichbar sein, und das darf nicht davon
       abhaengen, dass jemand ein Menue pflegt. Was die Redaktion ergaenzt,
       kommt dahinter. #}
    <nav class="flex flex-wrap gap-4">
        <a class="underline" href="/impressum">Impressum</a>
        <a class="underline" href="/datenschutz">Datenschutz</a>
        <a class="underline" href="/nutzungsbedingungen">Nutzungsbedingungen</a>
        <a class="underline" href="/kontakt">Kontakt</a>
        <a class="underline" href="/news/">{{ t('inhalt.news_titel') }}</a>
        {% if betrachter is defined %}
            {% for eintrag in betrachter.menu('fussbereich') %}
                <a class="underline" href="{{ eintrag.resolvedPath }}"
                   {% if eintrag.isExternal %}rel="noopener noreferrer"{% endif %}>{{ eintrag.label }}</a>
            {% endfor %}
        {% endif %}
    </nav>
</footer>
{% block skripte %}{% endblock %}
</body>
</html>
