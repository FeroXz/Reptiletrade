<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block titel %}Reptilienmarkt{% endblock %}</title>
    <meta name="description" content="{% block beschreibung %}Verkaufs- und Tauschplattform für Terrarientiere im DACH-Raum.{% endblock %}">
    {% block kopf %}{% endblock %}
    <link rel="stylesheet" href="/assets/app.css">
    <script defer src="/assets/alpine.js"></script>
</head>
<body class="min-h-screen">
<header class="border-b" style="background: var(--flaeche); border-color: var(--rand)">
    <div class="mx-auto flex max-w-7xl items-center gap-6 px-4 py-3">
        <a href="/markt/" class="text-lg font-semibold tracking-tight">Reptilienmarkt</a>
        <form action="/markt/" method="get" class="flex flex-1 items-center gap-2" role="search">
            <label for="suchfeld" class="sr-only">Suchbegriff</label>
            <input id="suchfeld" type="search" name="q" class="feld" placeholder="Art, Morph oder Stichwort"
                   value="{{ kriterien is defined and kriterien.query ? kriterien.query : '' }}">
            <button type="submit" class="knopf knopf-primaer">Suchen</button>
        </form>
    </div>
</header>

<main class="mx-auto max-w-7xl px-4 py-6">
    {% block inhalt %}{% endblock %}
</main>

<footer class="mx-auto max-w-7xl px-4 py-10 text-sm gedaempft">
    <p>
        Angaben zu Schutzstatus und Nachweispflichten sind Hinweise, keine Rechtsberatung.
        Prüfe vor Kauf und Abgabe die für dich geltenden Vorschriften.
    </p>
</footer>
{% block skripte %}{% endblock %}
</body>
</html>
