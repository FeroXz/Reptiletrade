{% if block.data.bilder is defined %}
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {% for bild in block.data.bilder %}
            <figure class="space-y-1">
                <img src="{{ bild.pfad }}" alt="{{ bild.alt_text|default('') }}"
                     width="{{ bild.breite|default(0) }}" height="{{ bild.hoehe|default(0) }}"
                     loading="lazy" decoding="async" class="w-full rounded">
                {% if bild.bildunterschrift is defined and bild.bildunterschrift %}
                    <figcaption class="text-sm gedaempft">{{ bild.bildunterschrift }}</figcaption>
                {% endif %}
            </figure>
        {% endfor %}
    </div>
{% endif %}
