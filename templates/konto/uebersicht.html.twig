{% extends 'layout/basis.html.twig' %}
{% block titel %}{{ t('konto.titel') }} — Reptilienmarkt{% endblock %}
{% block kopf %}<meta name="robots" content="noindex">{% endblock %}

{% block inhalt %}
    <div class="mx-auto max-w-4xl space-y-8">
        {% include 'partials/meldungen.html.twig' %}

        <div class="space-y-3">
            <p class="vorzeile">{{ nutzer.email }}</p>
            <h1 class="text-h1">{{ t('konto.titel') }}</h1>
        </div>

        {# ------------------------------------------------------ Verifizierung #}
        <section class="karte karte-gross space-y-4 p-6 sm:p-8">
            <div class="flex items-baseline justify-between gap-3">
                <h2 class="text-h3">{{ t('konto.verifizierung') }}</h2>
                <span class="text-sm gedaempft">{{ stufe.label }}</span>
            </div>
            <p class="text-sm gedaempft">{{ t('verifizierung.hinweis') }}</p>

            <ol class="space-y-3">
                {# Stufe 1: E-Mail #}
                <li class="flex items-center justify-between gap-4 border-t pt-3" style="border-color: var(--rand)">
                    <span>
                        <strong>1. E-Mail</strong>
                        <span class="gedaempft">{{ nutzer.email }}</span>
                    </span>
                    {% if nutzer.hasVerifiedEmail %}
                        <span class="text-sm">bestätigt</span>
                    {% else %}
                        <form method="post" action="/konto/email-senden">
                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                            <button type="submit" class="knopf">Bestätigungslink senden</button>
                        </form>
                    {% endif %}
                </li>

                {# Stufe 2: Telefon #}
                <li class="border-t pt-3" style="border-color: var(--rand)">
                    <div class="flex items-center justify-between gap-4">
                        <span>
                            <strong>2. Telefon</strong>
                            <span class="gedaempft">{{ nutzer.phone|default(t('allgemein.keine_angabe')) }}</span>
                        </span>
                        {% if nutzer.phoneVerifiedAt %}<span class="text-sm">bestätigt</span>{% endif %}
                    </div>

                    {% if not nutzer.phoneVerifiedAt %}
                        <div class="mt-2 grid gap-2 sm:grid-cols-2">
                            <form method="post" action="/konto/telefon" class="flex gap-2">
                                <input type="hidden" name="_csrf" value="{{ csrf }}">
                                <input class="feld" type="tel" name="telefon" placeholder="+49 176 1234567"
                                       value="{{ nutzer.phone|default('') }}" required
                                       {{ nutzer.hasVerifiedEmail ? '' : 'disabled' }}>
                                <button type="submit" class="knopf" {{ nutzer.hasVerifiedEmail ? '' : 'disabled' }}>
                                    Code senden
                                </button>
                            </form>
                            <form method="post" action="/konto/telefon-bestaetigen" class="flex gap-2">
                                <input type="hidden" name="_csrf" value="{{ csrf }}">
                                <input class="feld" type="text" name="code" inputmode="numeric" pattern="\d{6}"
                                       placeholder="6-stelliger Code" required>
                                <button type="submit" class="knopf">Bestätigen</button>
                            </form>
                        </div>
                        {% if not nutzer.hasVerifiedEmail %}
                            <p class="mt-1 text-xs gedaempft">Bestätige zuerst deine E-Mail-Adresse.</p>
                        {% endif %}
                    {% endif %}
                </li>

                {# Stufe 3: Ausweis oder Gewerbenachweis #}
                <li class="border-t pt-3" style="border-color: var(--rand)">
                    <div class="flex items-center justify-between gap-4">
                        <strong>3. Identität</strong>
                        {% if nutzer.identityVerifiedAt %}<span class="text-sm">geprüft</span>{% endif %}
                    </div>

                    <p class="mt-1 text-xs gedaempft">
                        Freiwillig. Der Nachweis liegt außerhalb des Webservers und ist nur für die
                        Moderation einsehbar. Nach der Prüfung wird er gelöscht.
                    </p>

                    <form method="post" action="/konto/nachweis" enctype="multipart/form-data" class="mt-2 flex flex-wrap gap-2">
                        <input type="hidden" name="_csrf" value="{{ csrf }}">
                        <select class="feld w-auto" name="art" aria-label="Art des Nachweises">
                            {% for art in nachweis_arten %}
                                <option value="{{ art.value }}">{{ art.label }}</option>
                            {% endfor %}
                        </select>
                        <input class="feld w-auto" type="file" name="datei" accept="application/pdf,image/*" required>
                        <button type="submit" class="knopf">Hochladen</button>
                    </form>

                    {% if nachweise is not empty %}
                        <ul class="mt-3 space-y-1 text-sm">
                            {% for nachweis in nachweise %}
                                <li class="flex justify-between gap-4">
                                    <span>{{ nachweis.docType.label }} — {{ nachweis.originalFilename }}</span>
                                    <span class="gedaempft">{{ nachweis.status.label }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </li>
            </ol>
        </section>

        {# ---------------------------------------------------------- Sicherheit #}
        <section class="karte karte-gross space-y-4 p-6 sm:p-8">
            <h2 class="text-h3">{{ t('konto.sicherheit') }}</h2>

            <form method="post" action="/konto/passwort" class="grid gap-2 sm:grid-cols-3">
                <input type="hidden" name="_csrf" value="{{ csrf }}">
                <input class="feld" type="password" name="aktuelles_passwort" placeholder="Aktuelles Passwort"
                       required autocomplete="current-password">
                <input class="feld" type="password" name="neues_passwort" placeholder="Neues Passwort"
                       required minlength="10" autocomplete="new-password">
                <button type="submit" class="knopf">{{ t('konto.passwort_aendern') }}</button>
            </form>

            <div class="border-t pt-4" style="border-color: var(--rand)">
                <div class="flex items-center justify-between gap-4">
                    <span>
                        <strong>Zwei-Faktor-Anmeldung</strong>
                        <span class="gedaempft">{{ zwei_faktor ? 'aktiv' : 'nicht eingerichtet' }}</span>
                    </span>

                    {% if zwei_faktor %}
                        <form method="post" action="/konto/zwei-faktor/aus" class="flex gap-2">
                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                            <input class="feld w-auto" type="password" name="passwort" placeholder="Passwort" required>
                            <button type="submit" class="knopf">Abschalten</button>
                        </form>
                    {% else %}
                        <form method="post" action="/konto/zwei-faktor">
                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                            <button type="submit" class="knopf">Einrichten</button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </section>

        {# Zehn unterstrichene Woerter in einer umbrechenden Zeile waren als
           Liste kaum zu ueberfliegen — welcher Link wohin fuehrt, stand nur im
           Wort selbst. Als Kachelraster hat jeder Eintrag eine eigene Flaeche
           und eine Zeile Erklaerung. Die Ziele sind unveraendert. #}
        {# Die Zeichen liegen als Pfaddaten am Eintrag und werden unten in ein
           einziges svg-Geruest gegossen. Als fertiges Markup im Array
           braeuchte es |raw — und damit eine Stelle, an der Twig nicht mehr
           escaped. Pfaddaten enthalten weder Anfuehrungszeichen noch spitze
           Klammern und ueberstehen das Escaping unveraendert. #}
        <nav aria-label="{{ t('konto.titel') }}">
            <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-einblenden-gruppe>
                {% for eintrag in [
                    { pfad: '/konto/profil', titel: t('profil.bearbeiten'), text: 'Anzeigename, Beschreibung und öffentliches Züchterprofil.',
                      zeichen: ['M12 4a4 4 0 1 1 0 8 4 4 0 0 1 0-8', 'M4 20c0-3.3 3.6-5.5 8-5.5s8 2.2 8 5.5'] },
                    { pfad: '/konto/statistik', titel: t('statistik.titel'), text: 'Aufrufe und Nachfragen zu deinen Anzeigen.',
                      zeichen: ['M3 20h18', 'M6 20v-6', 'M12 20V5', 'M18 20v-9'] },
                    { pfad: '/konto/nachzuchten', titel: t('nachzucht.titel'), text: 'Erwartete und gemeldete Nachzuchten.',
                      zeichen: ['M12 21v-7', 'M12 14c0-3.3 2.7-6 6-6 0 3.3-2.7 6-6 6', 'M12 14c0-2.5-2-4.5-4.5-4.5C7.5 12 9.5 14 12 14'] },
                    { pfad: '/paarung/simulator', titel: t('genetik.titel'), text: 'Vererbung einer geplanten Verpaarung durchrechnen.',
                      zeichen: ['M7 3c0 4.5 10 4.5 10 9s-10 4.5-10 9', 'M17 3c0 4.5-10 4.5-10 9s10 4.5 10 9', 'M9 7h6', 'M9 17h6'] },
                    { pfad: '/konto/abrechnung', titel: t('abrechnung.titel'), text: 'Tarif, Zahlungen und Rechnungen.',
                      zeichen: ['M3 8a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z', 'M3 10.5h18', 'M6.5 15h3'] },
                    { pfad: '/konto/sitzungen', titel: t('sitzungen.titel'), text: 'Angemeldete Geräte einsehen und abmelden.',
                      zeichen: ['M4 5.5h16v9H4z', 'M2 18.5h20'] },
                    { pfad: '/konto/merkliste', titel: t('merkliste.titel'), text: 'Gemerkte Anzeigen.',
                      zeichen: ['M12 20S4.5 15.3 4.5 10.6A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7.5 2.6C19.5 15.3 12 20 12 20'] },
                    { pfad: '/konto/suchen', titel: t('suchen.titel'), text: 'Gespeicherte Suchen und ihre Benachrichtigungen.',
                      zeichen: ['M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14', 'M16.2 16.2 21 21'] },
                    { pfad: '/konto/benachrichtigungen', titel: t('benachrichtigung.titel'), text: 'Wann dich eine E-Mail erreichen soll.',
                      zeichen: ['M18 16v-5a6 6 0 1 0-12 0v5l-1.5 2.5h15z', 'M10 21a2.2 2.2 0 0 0 4 0'] },
                    { pfad: '/konto/daten', titel: t('daten.titel'), text: 'Auskunft, Export und Löschung deines Kontos.',
                      zeichen: ['M12 3l7.5 3v5.5c0 4.5-3.2 8-7.5 9.5-4.3-1.5-7.5-5-7.5-9.5V6z', 'M9 12.2l2.2 2.2L15.5 10'] }
                ] %}
                    <li>
                        {# Die ganze Kachel ist der Link — ein Ziel, eine
                           Trefferflaeche. Zwei verschachtelte Links waeren fuer
                           die Tastaturbedienung zwei Stationen fuer denselben
                           Weg. #}
                        <a class="karte karte-interaktiv konto-kachel" href="{{ eintrag.pfad }}">
                            {# Das Zeichen wiederholt nur, was daneben steht —
                               deshalb aria-hidden. #}
                            <span class="konto-zeichen" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor"
                                     stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                    {% for d in eintrag.zeichen %}<path d="{{ d }}"></path>{% endfor %}
                                </svg>
                            </span>
                            <span class="font-semibold">{{ eintrag.titel }}</span>
                            <span class="text-xs gedaempft">{{ eintrag.text }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </nav>
    </div>
{% endblock %}
