{% extends 'layout/basis.html.twig' %}
{% block titel %}{{ t('merkliste.titel') }} — Reptilienmarkt{% endblock %}
{% block kopf %}<meta name="robots" content="noindex">{% endblock %}

{% block inhalt %}
    <div class="mx-auto max-w-3xl space-y-6">
        {% include 'partials/meldungen.html.twig' %}

        <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h1 class="text-xl font-semibold">{{ t('merkliste.titel') }}</h1>
            <a class="text-sm underline" href="/konto/">{{ t('daten.zurueck') }}</a>
        </div>

        {% if eintraege is empty %}
            <p class="karte p-6 text-sm">{{ t('merkliste.leer') }}</p>
        {% else %}
            <ul class="space-y-3">
                {% for eintrag in eintraege %}
                    <li class="karte flex flex-wrap items-center gap-4 p-4">
                        <div class="h-16 w-20 shrink-0 overflow-hidden rounded-sm"
                             style="background: var(--flaeche-gedaempft)">
                            {% if eintrag.imagePath %}
                                <img src="/uploads/{{ eintrag.imagePath }}" alt="{{ eintrag.title }}"
                                     loading="lazy" class="h-full w-full object-cover">
                            {% endif %}
                        </div>

                        <div class="min-w-40 grow space-y-1">
                            {% if eintrag.isReachable %}
                                <a class="font-medium underline" href="/anzeige/{{ eintrag.listingId }}/">
                                    {{ eintrag.title }}
                                </a>
                            {% else %}
                                {# Kein Verweis ins Leere: Die Anzeige ist da,
                                   aber gerade nicht zu sehen. #}
                                <span class="font-medium">{{ eintrag.title }}</span>
                            {% endif %}

                            <p class="text-xs gedaempft">
                                {{ eintrag.speciesCommonName ?? '' }}
                                {% if eintrag.priceCents %}
                                    · {{ (eintrag.priceCents / 100)|number_format(2, ',', '.') }} {{ eintrag.currency }}
                                {% endif %}
                            </p>

                            {% if not eintrag.isReachable %}
                                <p class="inline-block rounded-full px-2 py-0.5 text-xs"
                                   style="background: var(--rand)">
                                    {{ t('merkliste.zustand', {'zustand': eintrag.status.label}) }}
                                </p>
                            {% endif %}
                        </div>

                        <form method="post" action="/anzeige/{{ eintrag.listingId }}/entmerken">
                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                            <input type="hidden" name="weiter" value="/konto/merkliste">
                            <button type="submit" class="knopf">{{ t('merkliste.entmerken') }}</button>
                        </form>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endblock %}
