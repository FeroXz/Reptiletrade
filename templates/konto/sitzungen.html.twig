{% extends 'layout/basis.html.twig' %}
{% block titel %}{{ t('sitzungen.titel') }} — Reptilienmarkt{% endblock %}
{% block kopf %}<meta name="robots" content="noindex">{% endblock %}

{% block inhalt %}
    <div class="mx-auto max-w-2xl space-y-6">
        {% include 'partials/meldungen.html.twig' %}

        <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h1 class="text-xl font-semibold">{{ t('sitzungen.titel') }}</h1>
            <a class="text-sm underline" href="/konto/">{{ t('daten.zurueck') }}</a>
        </div>

        <p class="text-sm gedaempft">{{ t('sitzungen.erklaerung') }}</p>

        <ul class="space-y-3">
            {% for sitzung in sitzungen %}
                <li class="karte flex flex-wrap items-center justify-between gap-4 p-4">
                    <div class="space-y-1">
                        <p class="text-sm font-medium">
                            {{ sitzung.deviceLabel }}
                            {% if sitzung.id == aktuelle %}
                                <span class="ml-1 rounded-full px-2 py-0.5 text-xs"
                                      style="background: var(--rand)">{{ t('sitzungen.diese') }}</span>
                            {% endif %}
                        </p>
                        <p class="text-xs gedaempft">
                            {{ t('sitzungen.zuletzt', {'zeitpunkt': sitzung.lastSeenAt.format('d.m.Y H:i')}) }}
                            {% if sitzung.ipAddress %}
                                · {{ sitzung.ipAddress }}
                            {% endif %}
                        </p>
                        <p class="text-xs gedaempft">
                            {{ t('sitzungen.angemeldet_seit', {'zeitpunkt': sitzung.createdAt.format('d.m.Y')}) }}
                        </p>
                    </div>

                    {% if sitzung.id != aktuelle %}
                        <form method="post" action="/konto/sitzungen/{{ sitzung.id }}/beenden">
                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                            <button type="submit" class="knopf">{{ t('sitzungen.beenden') }}</button>
                        </form>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>

        <section class="karte space-y-3 p-6">
            <h2 class="font-semibold">{{ t('sitzungen.alle_titel') }}</h2>
            <p class="text-sm">{{ t('sitzungen.alle_erklaerung') }}</p>

            <form method="post" action="/konto/sitzungen/alle-beenden" class="space-y-3">
                <input type="hidden" name="_csrf" value="{{ csrf }}">
                <div>
                    <label class="text-sm" for="sitzungen-passwort">{{ t('sitzungen.passwort') }}</label>
                    <input class="feld" id="sitzungen-passwort" type="password" name="passwort"
                           autocomplete="current-password" required>
                </div>
                <button type="submit" class="knopf knopf-warnung">{{ t('sitzungen.alle_beenden') }}</button>
            </form>
        </section>
    </div>
{% endblock %}
