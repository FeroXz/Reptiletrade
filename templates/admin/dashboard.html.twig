{% extends 'layout/basis.html.twig' %}
{% block titel %}Verwaltung — Reptilienmarkt{% endblock %}
{% block kopf %}<meta name="robots" content="noindex">{% endblock %}

{% block inhalt %}
    <div class="mx-auto max-w-5xl space-y-6">
        {% include 'partials/meldungen.html.twig' %}

        <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h1 class="text-xl font-semibold">{{ t('admin.titel') }}</h1>
            <nav class="flex gap-3 text-sm">
                <a class="underline" href="/admin/anzeigen">{{ t('admin.anzeigen') }}</a>
                <a class="underline" href="/admin/nutzer">Konten</a>
                <a class="underline" href="/admin/kontakt">Anfragen</a>
                <a class="underline" href="/admin/artenstamm">{{ t('admin.artenstamm') }}</a>
                <a class="underline" href="/moderation/">{{ t('admin.moderation') }}</a>
            </nav>
        </div>

        {# ------------------------------------------------------ Wartet auf uns #}
        <section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            {% for kachel in [
                { t: t('admin.offene_meldungen'), w: kennzahlen.openReports, l: '/moderation/' },
                { t: t('admin.anzeigen_pruefung'), w: kennzahlen.listingsInReview, l: '/moderation/' },
                { t: t('admin.nachweise_offen'), w: kennzahlen.pendingDocuments, l: '/moderation/' },
                { t: t('admin.markierte_nachrichten'), w: kennzahlen.flaggedMessages, l: '/moderation/' }
            ] %}
                <a class="karte p-4" href="{{ kachel.l }}">
                    <p class="text-2xl font-semibold {{ kachel.w > 0 ? '' : 'gedaempft' }}">{{ kachel.w }}</p>
                    <p class="text-sm gedaempft">{{ kachel.t }}</p>
                </a>
            {% endfor %}
        </section>

        {# ------------------------------------------------------------ Bestand #}
        <section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            {% for kachel in [
                { t: t('admin.aktive_anzeigen'), w: kennzahlen.activeListings, l: '/admin/anzeigen?status=aktiv' },
                { t: t('admin.pausierte_anzeigen'), w: kennzahlen.pausedListings, l: '/admin/anzeigen?nur_pausiert=1' },
                { t: t('admin.aktive_konten'), w: kennzahlen.activeUsers, l: null },
                { t: t('admin.neue_konten'), w: kennzahlen.newUsersThisWeek, l: null }
            ] %}
                <div class="karte p-4">
                    <p class="text-2xl font-semibold">{{ kachel.w }}</p>
                    {% if kachel.l %}
                        <a class="text-sm underline gedaempft" href="{{ kachel.l }}">{{ kachel.t }}</a>
                    {% else %}
                        <p class="text-sm gedaempft">{{ kachel.t }}</p>
                    {% endif %}
                </div>
            {% endfor %}
        </section>

        {# ------------------------------------------------------ Anzeigen/Tag #}
        <section class="karte p-6">
            <h2 class="font-semibold">{{ t('admin.anzeigen_pro_tag') }}</h2>

            {% set hoch = kennzahlen.peakPerDay %}
            <div class="mt-4 flex items-end gap-1" style="height: 8rem" role="img"
                 aria-label="{{ t('admin.anzeigen_pro_tag') }}">
                {% for tag, anzahl in kennzahlen.listingsPerDay %}
                    <div class="flex flex-1 flex-col items-center justify-end gap-1" title="{{ tag }}: {{ anzahl }}">
                        <span class="text-xs gedaempft">{{ anzahl > 0 ? anzahl : '' }}</span>
                        <span class="w-full rounded-t"
                              style="background: var(--primaer, #16a34a);
                                     height: {{ hoch > 0 ? (anzahl / hoch * 100)|round : 0 }}%;
                                     min-height: {{ anzahl > 0 ? '2px' : '0' }}"></span>
                        <span class="text-[10px] gedaempft">{{ tag|slice(8, 2) }}</span>
                    </div>
                {% endfor %}
            </div>
        </section>

        {# ----------------------------------------------------------- Top-Arten #}
        <section class="karte p-6">
            <h2 class="font-semibold">{{ t('admin.top_arten') }}</h2>

            {% if kennzahlen.topSpecies is empty %}
                <p class="mt-2 text-sm gedaempft">{{ t('admin.keine_daten') }}</p>
            {% else %}
                <ol class="mt-3 space-y-1 text-sm">
                    {% for eintrag in kennzahlen.topSpecies %}
                        <li class="flex justify-between gap-4">
                            <span>{{ loop.index }}. {{ eintrag.art }}</span>
                            <span class="gedaempft">{{ eintrag.anzahl }}</span>
                        </li>
                    {% endfor %}
                </ol>
            {% endif %}
        </section>

        {# ------------------------------------------------------- Rechtstexte #}
        <section class="karte p-6">
            <h2 class="font-semibold">{{ t('admin.rechtstexte') }}</h2>

            {% if kennzahlen.staleLegalTexts is empty %}
                <p class="mt-2 text-sm gedaempft">{{ t('admin.rechtstexte_aktuell') }}</p>
            {% else %}
                <p class="mt-2 text-sm">{{ t('admin.rechtstexte_faellig', {'anzahl': kennzahlen.staleLegalTexts|length}) }}</p>
                <ul class="mt-2 space-y-1 text-sm">
                    {% for text in kennzahlen.staleLegalTexts %}
                        <li class="flex justify-between gap-4">
                            <span>{{ text.title }}</span>
                            <span class="gedaempft">
                                {{ text.lastReviewedAt ? text.lastReviewedAt.format('d.m.Y') : t('admin.nie_geprueft') }}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        {# ------------------------------------------------------------- Betrieb #}
        <section class="karte space-y-3 p-6">
            <h2 class="font-semibold">{{ t('admin.betrieb') }}</h2>

            <p class="text-sm">
                {{ t('admin.jobs_wartend', {'anzahl': kennzahlen.waitingJobs}) }},
                {{ t('admin.jobs_fehlgeschlagen', {'anzahl': kennzahlen.failedJobs}) }}
            </p>

            {% if fehlgeschlagene_jobs is not empty %}
                <ul class="space-y-1 text-sm">
                    {% for job in fehlgeschlagene_jobs %}
                        <li class="border-t pt-1" style="border-color: var(--rand)">
                            <span class="font-medium">{{ job.type }}</span>
                            <span class="gedaempft">
                                — {{ job.attempts }}/{{ job.maxAttempts }} Versuche
                            </span>
                            <span class="block text-xs gedaempft">{{ job.lastError }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            <div class="border-t pt-3" style="border-color: var(--rand)">
                <h3 class="text-sm font-medium">{{ t('admin.fristen') }}</h3>
                <ul class="mt-1 grid gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
                    {% for name, tage in fristen %}
                        <li class="flex justify-between gap-4">
                            <span class="gedaempft">{{ name }}</span>
                            <span>{{ tage > 0 ? tage ~ ' Tage' : t('admin.frist_aus') }}</span>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </section>

        <p class="karte border-amber-300 p-4 text-sm">
            <strong>{{ disclaimer_titel }}</strong><br>
            {{ disclaimer_text }}
        </p>
    </div>
{% endblock %}
