{% extends 'layout/basis.html.twig' %}
{% block titel %}{{ t('admin.texte.titel') }} — Reptilienmarkt{% endblock %}
{% block kopf %}<meta name="robots" content="noindex">{% endblock %}

{% block inhalt %}
    <div class="mx-auto max-w-5xl space-y-6">
        {% include 'partials/meldungen.html.twig' %}

        <div class="flex flex-wrap items-baseline justify-between gap-3">
            <div>
                <h1 class="text-xl font-semibold">{{ t('admin.texte.titel') }}</h1>
                <p class="gedaempft">{{ t('admin.texte.erklaerung') }}</p>
            </div>
            <a class="text-sm underline" href="/admin/">{{ t('admin.titel') }}</a>
        </div>

        {# Suche und Bereich als GET-Formular: Die Ansicht bleibt verlinkbar,
           und nach dem Speichern führt die Weiterleitung wieder hierher. #}
        <form method="get" action="/admin/texte" class="karte flex flex-wrap items-end gap-3 p-4">
            <div class="grow">
                <label class="text-sm" for="q">{{ t('admin.texte.suche') }}</label>
                <input class="feld" id="q" type="search" name="q" value="{{ suche }}"
                       placeholder="{{ t('admin.texte.suche_platzhalter') }}">
            </div>
            <div>
                <label class="text-sm" for="bereich">{{ t('admin.texte.bereich') }}</label>
                <select class="feld" id="bereich" name="bereich">
                    <option value="">{{ t('admin.texte.alle_bereiche') }}</option>
                    {% for name in bereiche %}
                        <option value="{{ name }}" {{ bereich == name ? 'selected' : '' }}>{{ name }}</option>
                    {% endfor %}
                </select>
            </div>
            <button type="submit" class="knopf">{{ t('admin.texte.filtern') }}</button>
        </form>

        <p class="text-sm gedaempft">
            {{ tw('admin.texte.treffer', texte|length) }}{% if geaendert > 0 %} · {{ tw('admin.texte.geaendert', geaendert) }}{% endif %}
        </p>

        {% if texte is empty %}
            <p class="karte p-4 text-sm gedaempft">{{ t('admin.texte.keine_treffer') }}</p>
        {% else %}
            <form method="post" action="/admin/texte" class="space-y-3">
                <input type="hidden" name="_csrf" value="{{ csrf }}">
                <input type="hidden" name="q" value="{{ suche }}">
                <input type="hidden" name="bereich" value="{{ bereich }}">

                {% for text in texte %}
                    <div class="karte space-y-2 p-4">
                        <div class="flex flex-wrap items-baseline justify-between gap-2">
                            <code class="text-sm">{{ text.key }}</code>
                            {% if text.isOverridden %}
                                <span class="text-xs" style="color: var(--warnung-text, #78350f)">
                                    {{ t('admin.texte.geaendert_am', {'datum': text.updatedAt ? text.updatedAt|date('d.m.Y H:i') : ''}) }}
                                </span>
                            {% endif %}
                        </div>

                        <label class="sr-only" for="text-{{ loop.index }}">{{ text.key }}</label>
                        <textarea class="feld" id="text-{{ loop.index }}" name="texte[{{ text.key }}]"
                                  rows="{{ text.current|length > 120 ? 3 : 2 }}"
                                  maxlength="{{ max_laenge }}">{{ text.current }}</textarea>

                        {% if text.placeholders is not empty %}
                            <p class="text-xs gedaempft">
                                {{ t('admin.texte.platzhalter') }}
                                {% for platzhalter in text.placeholders %}<code>{{ '{' ~ platzhalter ~ '}' }}</code>{{ loop.last ? '' : ', ' }}{% endfor %}
                            </p>
                        {% endif %}

                        {% if text.isOverridden %}
                            <div class="flex flex-wrap items-baseline gap-3 text-xs">
                                <span class="gedaempft">{{ t('admin.texte.original') }}: {{ text.original }}</span>
                                <button type="submit" name="zuruecksetzen" value="{{ text.key }}" class="underline">
                                    {{ t('admin.texte.zuruecksetzen') }}
                                </button>
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}

                <button type="submit" class="knopf knopf-primaer">{{ t('allgemein.speichern') }}</button>
            </form>
        {% endif %}
    </div>
{% endblock %}
