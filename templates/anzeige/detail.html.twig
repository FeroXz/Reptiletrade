{% extends 'layout/basis.html.twig' %}

{% block titel %}{{ listing.title }} — {{ art.commonNameDe }} — Reptilienmarkt{% endblock %}
{% block beschreibung %}{{ listing.description|slice(0, 160) }}{% endblock %}

{% block kopf %}
    <link rel="canonical" href="{{ kanonisch }}">
    {% include 'partials/strukturierte_daten.html.twig' %}
{% endblock %}

{% block inhalt %}
    <article class="mx-auto max-w-4xl space-y-5">
        {% include 'partials/meldungen.html.twig' %}

        {% if not listing.status.isPubliclyVisible %}
            <p class="karte border-amber-300 p-3 text-sm">
                Diese Anzeige ist noch nicht öffentlich sichtbar (Status: {{ listing.status.label }}).
            </p>
        {% endif %}

        {# Galerie. Das erste Bild laeuft ueber beide Spalten und ist damit das
           Hero — es traegt den grossen Radius, die uebrigen bleiben Kacheln.
           Das overflow-hidden sitzt am Rahmen, damit der abgerundete Ausschnitt
           auch das Bild beschneidet. #}
        {% if medien is not empty %}
            <div class="grid gap-2 sm:grid-cols-2">
                {% for bild in medien %}
                    <div class="karte overflow-hidden {{ loop.first ? 'karte-gross sm:col-span-2' : '' }}">
                        <img src="/uploads/{{ bild.path }}" alt="{{ listing.title }}" loading="lazy"
                             class="w-full object-cover {{ loop.first ? 'aspect-video' : 'aspect-4/3' }}">
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        <header class="karte karte-gross space-y-1 p-6">
            <h1 class="text-2xl font-semibold sm:text-3xl">{{ listing.title }}</h1>
            <p class="gedaempft">
                <a class="underline" href="/art/{{ art.slug }}/">{{ art.commonNameDe }}</a>
                <span class="italic">({{ art.scientificName }})</span>
            </p>
            {% if morph_string %}
                <p class="text-primary-700">{{ morph_string }}</p>
                <p class="text-xs gedaempft">Genotyp: {{ genotyp }}</p>
            {% endif %}

            {# Der Preis ist die eine Zahl, wegen der die Seite aufgerufen wird.
               Er stand bisher in derselben Groesse wie der Rest des Kopfes. #}
            <p class="pt-3 text-2xl font-semibold tracking-tight">
                {% if listing.priceCents %}
                    {{ (listing.priceCents / 100)|number_format(2, ',', '.') }} {{ listing.currency }}{{ listing.negotiable ? ' VB' : '' }}
                {% else %}
                    <span class="gedaempft">{{ listing.type.value == 'tausch' ? 'Nur Tausch' : 'Preis auf Anfrage' }}</span>
                {% endif %}
            </p>
        </header>

        <section class="karte p-6">
            <h2 class="text-base font-semibold">Details</h2>
            <dl class="mt-3 grid gap-3 sm:grid-cols-3">
                {% for feld in [
                    { t: 'Anzeigenart', w: listing.type.label },
                    { t: 'Geschlecht', w: listing.sex.label },
                    { t: 'Herkunft', w: listing.cbStatus.label },
                    { t: 'Schlupfdatum', w: listing.hatchDate ? listing.hatchDate|date('d.m.Y') : '—' },
                    { t: 'Gewicht', w: listing.weightG ? listing.weightG ~ ' g' : '—' },
                    { t: 'Anzahl', w: listing.countAvailable },
                    { t: 'Übergabe', w: listing.handover.label },
                    { t: 'Standort', w: listing.postalCode ? (listing.country.value ~ '-' ~ listing.postalCode) : '—' }
                ] %}
                    <div class="datenpaar">
                        <dt class="text-xs uppercase tracking-wide gedaempft">{{ feld.t }}</dt>
                        <dd class="mt-0.5 text-sm font-medium">{{ feld.w }}</dd>
                    </div>
                {% endfor %}
            </dl>
        </section>

        {% if listing.description %}
            <section class="karte p-6">
                <h2 class="text-base font-semibold">Beschreibung</h2>
                <p class="mt-2 whitespace-pre-line text-sm">{{ listing.description }}</p>
            </section>
        {% endif %}

        {% if listing.tradeWanted %}
            <section class="karte p-6">
                <h2 class="text-base font-semibold">Tauschwunsch</h2>
                <p class="mt-2 text-sm">{{ listing.tradeWanted }}</p>
            </section>
        {% endif %}

        {# ------------------------------------------------------------- Anbieter #}
        {% if anbieter %}
            {# Die Handlungsaufforderung der Seite. karte-gross und der grosse
               Innenabstand heben sie aus der Reihe der Textkaesten heraus —
               dieser Kasten ist der Grund, warum die Seite existiert. #}
            <section class="karte karte-gross space-y-4 p-6 sm:p-8">
                <h2 class="text-base font-semibold">Anbieter</h2>

                <div class="flex flex-wrap items-baseline justify-between gap-3">
                    <p>
                        {% if anbieter_profil and anbieter_profil.isPublic %}
                            <a class="font-medium underline" href="/zuechter/{{ anbieter_profil.slug }}/">
                                {{ anbieter.displayName }}
                            </a>
                        {% else %}
                            <span class="font-medium">{{ anbieter.displayName }}</span>
                        {% endif %}

                        <span class="marke ml-1">{{ anbieter.verificationLevel.badge }}</span>

                        {% if anbieter.isCommercial %}
                            <span class="marke ml-1">Gewerblicher Anbieter</span>
                        {% endif %}
                    </p>

                    {# flex-wrap: Auf 360 Pixeln standen "Anbieter schreiben",
                       "Merken" und "Melden" bisher nebeneinander in einer
                       Zeile, die nicht umbrechen konnte. #}
                    {% if not ist_eigene %}
                        <span class="flex flex-wrap items-center gap-3">
                            {% if betrachter.isAuthenticated %}
                                <form method="post" action="/anzeige/{{ listing.id }}/nachricht">
                                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                                    <button type="submit" class="knopf knopf-primaer">Anbieter schreiben</button>
                                </form>

                                {# Echtes Formular. merkliste.js tauscht nur den
                                   Knopf, wenn es geladen ist. #}
                                <form method="post" data-merken data-gemerkt="{{ gemerkt ? 'ja' : 'nein' }}"
                                      action="/anzeige/{{ listing.id }}/{{ gemerkt ? 'entmerken' : 'merken' }}">
                                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                                    <input type="hidden" name="weiter" value="/anzeige/{{ listing.id }}/">
                                    <button type="submit" class="knopf" aria-pressed="{{ gemerkt ? 'true' : 'false' }}">
                                        {{ gemerkt ? t('merkliste.entmerken') : t('merkliste.merken') }}
                                    </button>
                                </form>

                                <a class="text-xs gedaempft underline" href="/melden/listing/{{ listing.id }}">
                                    {{ t('meldung.titel') }}
                                </a>
                            {% else %}
                                <a class="knopf knopf-primaer"
                                   href="/anmelden?weiter={{ ('/anzeige/' ~ listing.id ~ '/')|url_encode }}">
                                    Zum Schreiben anmelden
                                </a>
                            {% endif %}
                        </span>
                    {% endif %}
                </div>

                {% if anbieter.isCommercial and anbieter.hasImprint %}
                    <p class="whitespace-pre-line border-t pt-3 text-xs gedaempft" style="border-color: var(--rand)">
                        {{ anbieter.imprint }}
                    </p>
                {% endif %}

                {# Der Betrugshinweis stand als graue Kleinschrift unter dem
                   Kasten und las sich wie ein Nachsatz. Er warnt vor genau der
                   Masche, auf die Kaeufer hier hereinfallen — also bekommt er
                   eine eigene Flaeche direkt neben dem Knopf, der zur Zahlung
                   fuehrt. #}
                <p class="hinweis text-xs">
                    Bezahlt wird bei der Übergabe. Wer Vorkasse verlangt oder das Tier verschicken will,
                    gehört gemeldet — Versand über Paketdienste ist nicht zulässig.
                </p>
            </section>
        {% endif %}

        {% if ist_eigene %}
            <p class="text-right">
                <a class="knopf" href="/meine-anzeigen/">Zu meinen Anzeigen</a>
            </p>
        {% endif %}
    </article>
{% endblock %}

{% block skripte %}
    <script src="/assets/merkliste.js" defer></script>
{% endblock %}
