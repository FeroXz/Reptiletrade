{% extends 'layout/basis.html.twig' %}

{% block titel %}{{ listing.title }} — {{ art.commonNameDe }} — Reptilienmarkt{% endblock %}
{% block beschreibung %}{{ listing.description|slice(0, 160) }}{% endblock %}

{% block kopf %}
    <link rel="canonical" href="{{ kanonisch }}">
    {% include 'partials/strukturierte_daten.html.twig' %}
{% endblock %}

{% block inhalt %}
    <article class="mx-auto max-w-6xl space-y-8 lg:space-y-12">
        {% include 'partials/meldungen.html.twig' %}

        {% if not listing.status.isPubliclyVisible %}
            <p class="karte border-amber-300 p-3 text-sm">
                Diese Anzeige ist noch nicht öffentlich sichtbar (Status: {{ listing.status.label }}).
            </p>
        {% endif %}

        {# ----------------------------------------------------------- Hero #}
        {# Das erste Bild traegt den Kopf der Seite: Anzeigenart, Art und Titel
           liegen auf dem Bild, lesbar durch den Verlauf aus .bild-verlauf.
           Ohne Bild uebernimmt die Buehne dieselbe Rolle — die
           Ueberschriftenebene ist in beiden Faellen dieselbe. #}
        {% if medien is not empty %}
            {# Kein bild-verlauf hier: Der Verlauf sitzt am Textblock selbst und
               waechst mit ihm. Zwei Verlaeufe uebereinander wuerden das Foto
               unnoetig zudecken. #}
            <header class="detail-hero">
                {# Das Hero-Bild steht im sichtbaren Bereich — kein
                   loading="lazy", das kostet hier nur Zeit. #}
                <img src="/uploads/{{ medien|first.path }}" alt="{{ listing.title }}">

                <div class="bild-inhalt detail-hero-text">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="badge-akzent">{{ listing.type.label }}</span>
                        <span class="text-sm text-white/90">
                            {{ art.commonNameDe }}
                            <span class="italic">({{ art.scientificName }})</span>
                        </span>
                    </div>
                    <h1 class="mt-3 max-w-3xl text-h1 text-balance">{{ listing.title }}</h1>
                </div>
            </header>
        {% else %}
            <header class="buehne">
                <div class="max-w-3xl space-y-4">
                    <p class="vorzeile">{{ listing.type.label }}</p>
                    <h1 class="text-h1 text-balance">{{ listing.title }}</h1>
                    <p class="gedaempft">
                        <a class="underline" href="/art/{{ art.slug }}/">{{ art.commonNameDe }}</a>
                        <span class="italic">({{ art.scientificName }})</span>
                    </p>
                </div>
            </header>
        {% endif %}

        {# Zwei Spalten ab lg: links die Anzeige, rechts die Handlungskarte,
           die dort mitlaeuft. Darunter stehen sie untereinander — die
           Handlungskarte zuerst, weil sie das Ziel der Seite ist. #}
        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start lg:gap-10">
        <div class="order-2 space-y-6 lg:order-1">

        {# Die weiteren Bilder. Das erste steckt im Hero. #}
        {% if medien|length > 1 %}
            <div class="detail-galerie" data-einblenden-gruppe>
                {% for bild in medien|slice(1) %}
                    <div class="karte overflow-hidden">
                        <img src="/uploads/{{ bild.path }}" alt="{{ listing.title }}" loading="lazy">
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        <section class="karte karte-gross p-6 sm:p-8">
            <h2 class="text-h3">Details</h2>
            {% if morph_string %}
                <p class="morph-name mt-2">{{ morph_string }}</p>
                <p class="text-xs gedaempft">Genotyp: {{ genotyp }}</p>
            {% endif %}
            <dl class="mt-5 grid gap-3 sm:grid-cols-3">
                {% for feld in [
                    { t: 'Anzeigenart', w: listing.type.label },
                    { t: 'Geschlecht', w: listing.sex.label },
                    { t: 'Herkunft', w: listing.cbStatus.label },
                    { t: 'Schlupfdatum', w: listing.hatchDate ? listing.hatchDate|date('d.m.Y') : '—' },
                    { t: 'Gewicht', w: listing.weightG ? listing.weightG ~ ' g' : '—' },
                    { t: 'Anzahl', w: listing.countAvailable },
                    { t: 'Übergabe', w: listing.handover.label },
                    { t: 'Standort', w: listing.postalCode ? (listing.country.value ~ '-' ~ listing.postalCode) : '—' }
                ] %}
                    <div class="datenpaar">
                        <dt class="text-xs uppercase tracking-wide gedaempft">{{ feld.t }}</dt>
                        <dd class="mt-0.5 text-sm font-medium">{{ feld.w }}</dd>
                    </div>
                {% endfor %}
            </dl>
        </section>

        {% if listing.description %}
            <section class="karte karte-gross p-6 sm:p-8">
                <h2 class="text-h3">Beschreibung</h2>
                <p class="mt-3 whitespace-pre-line">{{ listing.description }}</p>
            </section>
        {% endif %}

        {% if listing.tradeWanted %}
            <section class="karte karte-gross p-6 sm:p-8">
                <h2 class="text-h3">Tauschwunsch</h2>
                <p class="mt-3">{{ listing.tradeWanted }}</p>
            </section>
        {% endif %}

        </div>

        {# ------------------------------------------------------------- Anbieter #}
        <div class="order-1 space-y-6 lg:order-2">
        {% if anbieter %}
            {# Die Handlungsaufforderung der Seite. Als karte-featured mit
               Verlaufsrand und auf breiten Bildschirmen mitlaufend: Dieser
               Kasten ist der Grund, warum die Seite existiert, und er soll
               erreichbar bleiben, ohne dass man nach oben scrollt. #}
            <section class="karte karte-featured haftend-desktop space-y-5 p-6 sm:p-7">
                {# Der Preis steht hier und nicht mehr im Kopf: an der Stelle,
                   an der man sich fuer den naechsten Schritt entscheidet. #}
                <p class="preis-gross">
                    {% if listing.priceCents %}
                        {{ (listing.priceCents / 100)|number_format(2, ',', '.') }} {{ listing.currency }}{{ listing.negotiable ? ' VB' : '' }}
                    {% else %}
                        <span class="gedaempft">{{ listing.type.value == 'tausch' ? 'Nur Tausch' : 'Preis auf Anfrage' }}</span>
                    {% endif %}
                </p>

                <h2 class="vorzeile">Anbieter</h2>

                <div class="space-y-4">
                    <p>
                        {% if anbieter_profil and anbieter_profil.isPublic %}
                            <a class="font-medium underline" href="/zuechter/{{ anbieter_profil.slug }}/">
                                {{ anbieter.displayName }}
                            </a>
                        {% else %}
                            <span class="font-medium">{{ anbieter.displayName }}</span>
                        {% endif %}

                        <span class="marke ml-1">{{ anbieter.verificationLevel.badge }}</span>

                        {% if anbieter.isCommercial %}
                            <span class="marke ml-1">Gewerblicher Anbieter</span>
                        {% endif %}
                    </p>

                    {# Untereinander statt nebeneinander: Die Handlungskarte ist
                       auf dem Desktop knapp 22rem breit, und auf 360 Pixeln
                       passten "Anbieter schreiben", "Merken" und "Melden" auch
                       vorher nicht in eine Zeile. #}
                    {% if not ist_eigene %}
                        <span class="flex flex-col gap-3">
                            {% if betrachter.isAuthenticated %}
                                <form method="post" action="/anzeige/{{ listing.id }}/nachricht">
                                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                                    <button type="submit" class="knopf knopf-primaer w-full justify-center">Anbieter schreiben</button>
                                </form>

                                {# Echtes Formular. merkliste.js tauscht nur den
                                   Knopf, wenn es geladen ist. #}
                                <form method="post" data-merken data-gemerkt="{{ gemerkt ? 'ja' : 'nein' }}"
                                      action="/anzeige/{{ listing.id }}/{{ gemerkt ? 'entmerken' : 'merken' }}">
                                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                                    <input type="hidden" name="weiter" value="/anzeige/{{ listing.id }}/">
                                    <button type="submit" class="knopf w-full justify-center" aria-pressed="{{ gemerkt ? 'true' : 'false' }}">
                                        {{ gemerkt ? t('merkliste.entmerken') : t('merkliste.merken') }}
                                    </button>
                                </form>

                                <a class="text-xs gedaempft underline" href="/melden/listing/{{ listing.id }}">
                                    {{ t('meldung.titel') }}
                                </a>
                            {% else %}
                                <a class="knopf knopf-primaer w-full justify-center"
                                   href="/anmelden?weiter={{ ('/anzeige/' ~ listing.id ~ '/')|url_encode }}">
                                    Zum Schreiben anmelden
                                </a>
                            {% endif %}
                        </span>
                    {% endif %}
                </div>

                {% if anbieter.isCommercial and anbieter.hasImprint %}
                    <p class="whitespace-pre-line border-t pt-3 text-xs gedaempft" style="border-color: var(--rand)">
                        {{ anbieter.imprint }}
                    </p>
                {% endif %}

                {# Der Betrugshinweis stand als graue Kleinschrift unter dem
                   Kasten und las sich wie ein Nachsatz. Er warnt vor genau der
                   Masche, auf die Kaeufer hier hereinfallen — also bekommt er
                   eine eigene Flaeche direkt neben dem Knopf, der zur Zahlung
                   fuehrt. #}
                <p class="hinweis text-xs">
                    Bezahlt wird bei der Übergabe. Wer Vorkasse verlangt oder das Tier verschicken will,
                    gehört gemeldet — Versand über Paketdienste ist nicht zulässig.
                </p>
            </section>
        {% endif %}

        {% if ist_eigene %}
            <p>
                <a class="knopf w-full justify-center" href="/meine-anzeigen/">Zu meinen Anzeigen</a>
            </p>
        {% endif %}
        </div>
        </div>
    </article>
{% endblock %}

{% block skripte %}
    <script src="/assets/merkliste.js" defer></script>
{% endblock %}
